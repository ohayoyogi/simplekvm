@@ -135,6 +163,9 @@ static void __no_inline_not_in_flash_func(usb_device_packet_handler)(void) {
   if (token == USB_PID_IN) {
     int8_t ep_num = device_receive_ep_address(token, addr);
     if (ep_num < 0) {
+      // IN for another device on the same TT: re-arm right at its EOP, or
+      // the packet that follows (often our own IN) is lost
+      rearm_receiver_at_eop(pp);
       gpio_set_mask(1 << 3);
       return;
     }
@@ -178,8 +209,14 @@ static void __no_inline_not_in_flash_func(usb_device_packet_handler)(void) {
         update_ep0_crc5_lut(rport->dev_addr);
       }
 
