+static void __no_inline_not_in_flash_func(device_in)(pio_port_t *pp, root_port_t *rport,
+                                                      int ep_num) {
+  endpoint_t *ep = PIO_USB_ENDPOINT((ep_num << 1) | 0x01);
+  bool const has_transfer = ep->has_transfer;
+  if (has_transfer) {
+    tx_packet(pp, ep->buffer, ep->encoded_data_len);
+  } else if (ep->stalled) {
+    tx_packet(pp, stall_encoded, sizeof(stall_encoded));
+  } else {
+    tx_packet(pp, nak_encoded, sizeof(nak_encoded));
+  }
+  if (!has_transfer) {
+    return;
+  }
+
+  // Advance only on the host's ACK; otherwise the same packet (same data
+  // toggle) goes out again on the next IN, as USB expects.
+  bool crc_ok;
+  if (rx_packet(pp, &crc_ok) != 2 || rx_buf[1] != USB_PID_ACK) {
+    return;
+  }
+
+  if (ep->ep_num == 0x80 && new_devaddr > 0) {
+    rport->dev_addr = new_devaddr;
+    new_devaddr = 0;
+    update_ep0_crc5_lut(rport->dev_addr);
+  }
+
+  // The next packet is encoded later by pio_usb_device_task(). Until then
+  // answer NAK: leaving has_transfer set would send this packet again and
+  // the pending continue would then skip data (multi-packet transfers such
+  // as a configuration descriptor over 64 bytes broke this way).
+  rport->ep_continue |= (1 << ep_num);
+  __dmb();
+  ep->has_transfer = false;
+  rport->ints |= PIO_USB_INTS_ENDPOINT_CONTINUE_BITS;
+}
+
+static void __no_inline_not_in_flash_func(device_out)(pio_port_t *pp, int ep_num) {
+  endpoint_t *ep = PIO_USB_ENDPOINT(ep_num << 1);
+  bool crc_ok;
+  int n = rx_packet(pp, &crc_ok);
+  if (n < 4 || (rx_buf[1] != USB_PID_DATA0 && rx_buf[1] != USB_PID_DATA1) || !crc_ok) {
+    return; // no handshake: the host retries
+  }
+  if (ep->stalled) {
+    tx_packet(pp, stall_encoded, sizeof(stall_encoded));
+    return;
+  }
+  if (!ep->has_transfer) {
+    tx_packet(pp, nak_encoded, sizeof(nak_encoded));
+    return;
+  }
+  tx_packet(pp, ack_encoded, sizeof(ack_encoded));
+
+  // Clamp to the transaction length the device actually allocated a buffer
+  // for. A non-compliant or malicious host could otherwise send an OUT
+  // packet larger than ep->app_buf, causing an out-of-bounds memcpy.
+  int res = n - 4;
+  uint16_t const xact_len = pio_usb_ll_get_transaction_len(ep);
+  if ((uint16_t)res > xact_len) {
+    res = xact_len;
+  }
+  memcpy(ep->app_buf, rx_buf + 2, res);
+  pio_usb_ll_transfer_continue(ep, res);
+}
