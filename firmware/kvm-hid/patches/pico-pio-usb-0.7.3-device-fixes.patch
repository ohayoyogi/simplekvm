+  pio_sm_exec(pio, sm, pio_encode_mov_not(pio_osr, pio_null));
+  pio_sm_exec(pio, sm, pio_encode_jmp(dev_rx_start_pc));
+  pio->irq = IRQ_RX_START_MASK;
+  pio_sm_set_enabled(pio, sm, true);
