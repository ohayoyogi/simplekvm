+// PIO IRQ on a packet start: handle packets as long as they keep coming.
+// Everything else on the bus (SOF, traffic for other devices behind the
+// same TT, handshakes) is read and dropped.
+static void __no_inline_not_in_flash_func(usb_device_packet_handler)(void) {
+  pio_port_t *pp = PIO_USB_PIO_PORT(0);
+  root_port_t *rport = PIO_USB_ROOT_PORT(0);
+  PIO pio = pp->pio_usb_rx;
+
+  while (!pio_sm_is_rx_fifo_empty(pio, pp->sm_rx) || (pio->irq & IRQ_RX_START_MASK)) {
+    pio->irq = IRQ_RX_START_MASK; // a packet starting from now on raises it again
+    bool crc_ok;
+    int n = rx_packet(pp, &crc_ok);
+    if (n != 4) {
+      continue; // not a token (or lost): nothing to answer
+    }
+    uint8_t const pid = rx_buf[1];
+    if (pid != USB_PID_IN && pid != USB_PID_OUT && pid != USB_PID_SETUP) {
+      continue;
+    }
+    int ep_num = token_ep(rx_buf[2], rx_buf[3], rport->dev_addr);
+    if (ep_num < 0) {
+      continue;
+    }
+    if (pid == USB_PID_IN) {
+      device_in(pp, rport, ep_num);
+    } else if (pid == USB_PID_OUT) {
+      device_out(pp, ep_num);
+    } else {
+      device_setup(pp, rport);
+    }
+  }
+  irq_clear(pp->device_rx_irq_num);
+}
