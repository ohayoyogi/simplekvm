+// Endpoint number of a token for this device, else -1 (address or CRC5
+// mismatch). b2 = ADDR | ENDP[0] << 7, b3 = ENDP[3:1] | CRC5 << 3.
+static __always_inline int token_ep(uint8_t b2, uint8_t b3, uint8_t dev_addr) {
+  if ((b2 & 0x7f) != dev_addr) {
+    return -1;
+  }
+  uint8_t ep = (uint8_t)(((b3 & 0x07) << 1) | (b2 >> 7));
+  return ep0_crc5_lut[ep] == b3 ? ep : -1;
+}
