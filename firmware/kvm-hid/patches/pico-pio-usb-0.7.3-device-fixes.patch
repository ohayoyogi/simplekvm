 static __always_inline void restart_usb_receiver(pio_port_t *pp) {
+  // drop a leftover bit trigger before the restart (see rearm_receiver_at_eop)
+  pp->pio_usb_rx->irq = 1u << DECODER_TRIGGER;
   pio_sm_exec(pp->pio_usb_rx, pp->sm_rx, pp->rx_reset_instr2);
   pio_sm_restart(pp->pio_usb_rx, pp->sm_rx);
   pp->pio_usb_rx->irq = IRQ_RX_ALL_MASK;
 }
 
+// Re-arm the receiver as soon as the current packet's EOP is seen. The edge
+// detector stalls on "irq wait IRQ_RX_EOP" until the CPU clears that flag,
+// and the next packet may start ~4 bit times (~330 ns) after EOP: right after
+// SOF a hub's TT sends the periodic (interrupt) IN tokens. Restart the
+// decoder and release the detector first; the FIFO is cleared afterwards
+// (the next byte needs > 600 ns to arrive).
+static __always_inline void rearm_receiver_at_eop(pio_port_t *pp) {
+  while ((pp->pio_usb_rx->irq & IRQ_RX_COMP_MASK) == 0) {
+    continue;
+  }
+  // SM restart does not clear IRQ flags: drop a leftover bit trigger while
+  // the detector is still parked on EOP, or the decoder shifts it in as the
+  // first bit of the next packet (SYNC/PID one bit off). Also put the
+  // decoder back at its first instruction (restart keeps the PC).
+  pp->pio_usb_rx->irq = 1u << DECODER_TRIGGER;
+  pio_sm_exec(pp->pio_usb_rx, pp->sm_rx, pp->rx_reset_instr);
+  pio_sm_exec(pp->pio_usb_rx, pp->sm_rx, pp->rx_reset_instr2);
+  pio_sm_restart(pp->pio_usb_rx, pp->sm_rx);
+  pp->pio_usb_rx->irq = IRQ_RX_ALL_MASK;
+  pio_sm_clear_fifos(pp->pio_usb_rx, pp->sm_rx);
+}
