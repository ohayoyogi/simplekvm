+
+// Read one packet up to its end marker into rx_buf (SYNC included).
+// Returns its length, or -1 if nothing arrives in time (bytes come every
+// ~0.7 us; a reply starts within ~1.5 us) or the packet does not fit.
+// crc_ok: the last two bytes are the CRC16 of the bytes after the PID.
+static int __no_inline_not_in_flash_func(rx_packet)(pio_port_t *pp, bool *crc_ok) {
+  PIO pio = pp->pio_usb_rx;
+  uint sm = pp->sm_rx;
+  uint16_t crc = 0xffff, crc1 = 0xffff, crc2 = 0xffff;
+  int n = 0;
+  uint32_t t0 = get_time_us_32();
+  while (true) {
+    if (pio_sm_is_rx_fifo_empty(pio, sm)) {
+      if (get_time_us_32() - t0 > 3) {
+        return -1;
+      }
+      continue;
+    }
+    uint32_t w = pio->rxf[sm];
+    if (w == RX_MARK) {
+      break;
+    }
+    t0 = get_time_us_32();
+    uint8_t b = (uint8_t)(w >> 24);
+    if (n < (int)sizeof(rx_buf)) {
+      rx_buf[n] = b;
+    }
+    if (n >= 2) {
+      crc2 = crc1;
+      crc1 = crc;
+      crc = update_usb_crc16(crc, b);
+    }
+    n++;
+  }
+  if (n > (int)sizeof(rx_buf)) {
+    return -1;
+  }
+  *crc_ok = n >= 4 && (uint16_t)((rx_buf[n - 2] | (rx_buf[n - 1] << 8)) ^ 0xffff) == crc2;
+  return n;
+}
+
+// Send an encoded packet; the receiver is off meanwhile.
+static void __no_inline_not_in_flash_func(tx_packet)(pio_port_t *pp, const uint8_t *data,
+                                                      uint len) {
+  pio_sm_set_enabled(pp->pio_usb_rx, pp->sm_rx, false);
+  pio_sm_exec(pp->pio_usb_tx, pp->sm_tx, pp->tx_start_instr);
+  dma_channel_transfer_from_buffer_now(pp->tx_ch, data, len);
+  pp->pio_usb_tx->irq = IRQ_TX_ALL_MASK; // clear complete flag
+  while ((pp->pio_usb_tx->irq & IRQ_TX_ALL_MASK) == 0) {
+    continue;
+  }
+  rx_restart(pp);
+}
